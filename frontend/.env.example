# Backend API (server-side calls from Next.js). ecom serves its own identity
# now, so there is no separate auth service URL.
ECOM_API_URL=http://localhost:4001

# Internal key for server-to-server calls to the ecom backend's internal
# endpoints (self-serve store provisioning). Must equal the backend's
# INTERNAL_API_KEY. Server-side only — never expose to the browser.
ECOM_INTERNAL_KEY=change-me-internal-api-key-please-rotate

# Public base used by client components (must be prefixed NEXT_PUBLIC_).
NEXT_PUBLIC_ECOM_API_URL=http://localhost:4001

# Root domain for tenant subdomains, e.g. "acme.shops.localhost".
NEXT_PUBLIC_ROOT_DOMAIN=shops.localhost

# ---------------------------------------------------------------------------
# ecom backend configuration. Every value is validated at boot (src/common/
# config/env.validation.ts); the process refuses to start on a bad value.
# Copy to `.env` for local development.
# ---------------------------------------------------------------------------

# App
APP_ENV=development            # development | staging | production
NODE_ENV=development
PORT=4001                      # auth-rbac-service uses 4000
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Observability. LOG_LEVEL: verbose|debug|log|warn|error|fatal (at `debug` the
# access log prints request payloads to debug what's happening). LOG_FORMAT:
# `pretty` for local console, `json` for structured, request-correlated lines.
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Database — two roles, exactly like auth-rbac-service.
#   DATABASE_URL : the RLS-forced, NON-superuser runtime role (serves requests)
#   DIRECT_URL   : the owner role (migrations, RLS bootstrap, seed ONLY)
DATABASE_URL=postgresql://ecom_rls:localdev_password@localhost:5433/ecom?schema=public
DIRECT_URL=postgresql://ecom:localdev_password@localhost:5433/ecom?schema=public

# Redis (rate limiting, caches)
REDIS_URL=redis://localhost:6380

# S3-compatible media (local MinIO; replace with S3/R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ecom-media
S3_ACCESS_KEY=ecom-local
S3_SECRET_KEY=ecom-local-secret
S3_FORCE_PATH_STYLE=true

# Master key for encrypting per-tenant secrets at rest (base64 of 32 bytes).
# REQUIRED. Generate a real one; the all-zero placeholder is rejected in production.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ---------------------------------------------------------------------------
# Native identity (ecom signs its own RS256 tokens + serves its own JWKS).
# ---------------------------------------------------------------------------
# Generate the keypair with: npm run keys:generate  (writes gitignored ./keys).
# Provide keys inline (JWT_PRIVATE_KEY) OR by file path (JWT_PRIVATE_KEY_FILE).
JWT_PRIVATE_KEY_FILE=./keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./keys/jwt-public.pem
JWT_KEY_ID=ecom-dev-1
JWT_ISSUER=ecom
JWT_AUDIENCE=ecom
ACCESS_TOKEN_TTL=900                        # seconds (15 min)
REFRESH_TOKEN_TTL=2592000                   # seconds (30 days)

# Password hashing (Argon2id + server-side pepper). Rotate by bumping the version.
PASSWORD_PEPPER=change-me-to-a-long-random-string-in-every-environment
PASSWORD_PEPPER_VERSION=1

# Keyed HMAC secret for hashing opaque tokens; shared secret for internal calls.
API_KEY_HASH_SECRET=change-me-api-key-hash-secret-please
INTERNAL_API_KEY=change-me-internal-api-key-please-rotate

# Session cookies set by the backend (staff + customer).
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                         # must be true in production

# Transactional email (verification, reset, invites). `console` prints the
# message to logs in dev; `smtp` sends via the SMTP_* transport in prod.
EMAIL_TRANSPORT=console                      # console | smtp
EMAIL_FROM=ecom <no-reply@localhost>
APP_BASE_URL=http://localhost:3000           # storefront/admin origin for email links
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Rate limiting (per IP unless noted; auth/checkout are stricter surfaces)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_CHECKOUT_PER_MINUTE=20
RATE_LIMIT_TENANT_PER_MINUTE=600           # per-tenant ceiling on general API

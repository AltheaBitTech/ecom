# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://ecom:ecom@localhost:5432/ecom_saas?schema=public
# Production (Supabase): DATABASE_URL = pooled connection string (port 6543, "Transaction" mode,
# from Supabase's Connect dialog); DIRECT_URL = the direct connection (port 5432). Only
# DATABASE_URL is read by the running app — DIRECT_URL is used solely by `prisma migrate deploy`.
DIRECT_URL=

# 32+ byte random secrets. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of allowed browser origins (storefront + admin frontend)
CORS_ORIGINS=http://localhost:3000

COOKIE_SECURE=false

# 32+ byte random secret for platform (cross-tenant super-admin) auth. Generate with: openssl rand -base64 48
PLATFORM_JWT_SECRET=

# Razorpay merchant credentials — required only to use the payments module.
# https://dashboard.razorpay.com/app/keys and https://dashboard.razorpay.com/app/webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Fallback store for a bare /store visit by an anonymous shopper. Every other visit names its
# store (?store=<slug>, sent as the x-store-slug header) and a signed-in seller sees their own.
# Only ACTIVE tenants are served publicly. Leave empty to serve no default store.
STOREFRONT_TENANT_SLUG=

# Notifications — all optional. Each channel is a thin fetch() wrapper (no SDK), lazily
# built the same way RAZORPAY_KEY_ID/SECRET are: unconfigured means that channel's send()
# throws instead of the app failing to boot. See notifications module.
# Email — Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# SMS + WhatsApp — Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# RazorpayX Payouts — automatic referral commission payout to a referrer's UPI VPA. Uses the
# same RAZORPAY_KEY_ID/SECRET above (RazorpayX must be enabled on that account); this is the
# RazorpayX current account number payouts are funded from. Optional — without it, a platform
# admin marking a commission "paid" just records it for manual settlement outside the system.
RAZORPAYX_ACCOUNT_NUMBER=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Social login / OAuth signup — set a provider's pair to enable it (create the app in that
# provider's developer console, redirect URI = BACKEND_URL/auth/oauth/<provider>/callback).
# Unset = that provider's button returns "isn't configured". Google needs verified emails.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# X/Twitter never shares the account's email, so it can't be used to sign up (login fails closed).
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
